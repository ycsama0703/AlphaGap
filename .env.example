# Copy to .env and fill in real values

# LLM provider: deepseek | mimo | openrouter | custom
# Leave this at deepseek for the existing daily run. Switch to openrouter to compare models.
LLM_PROVIDER=deepseek

# DeepSeek API (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Daily extraction and experiment triage use Flash; Pro is reserved for selected deep briefs.
DEEPSEEK_MODEL_DEFAULT=deepseek-v4-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-flash
DEEPSEEK_MODEL_BRIEF=deepseek-v4-pro

# OpenRouter API (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_BRIEF=
OPENROUTER_APP_TITLE=AlphaGap
# OPENROUTER_HTTP_REFERER=

# MiMo API (used when LLM_PROVIDER=mimo; base URL is account/plan specific)
MIMO_API_KEY=
MIMO_BASE_URL=
MIMO_MODEL_DEFAULT=mimo-v2.5-pro
MIMO_MODEL_REASONING=mimo-v2.5-pro
MIMO_MODEL_BRIEF=mimo-v2.5-pro

# Optional generic model override for the selected provider
# LLM_MODEL_DEFAULT=
# LLM_MODEL_REASONING=
# LLM_MODEL_BRIEF=
# Optional fallback pricing for providers that do not return cost in usage:
# LLM_INPUT_COST_PER_M=
# LLM_OUTPUT_COST_PER_M=
# LLM_REASONING_INPUT_COST_PER_M=
# LLM_REASONING_OUTPUT_COST_PER_M=
# LLM_BRIEF_INPUT_COST_PER_M=
# LLM_BRIEF_OUTPUT_COST_PER_M=

# Semantic Scholar（可选 API key 提速）
S2_API_KEY=

# Email — Resend
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=alphagap@yourdomain.com
EMAIL_TO=yuncong@lum.id

# Paths
ALPHAGAP_DB_PATH=db/alphagap.sqlite
ALPHAGAP_DATA_DIR=.

# Logging
LOG_LEVEL=INFO

# Behavior
DRY_RUN=false            # true = 不发邮件、不写 inbox，只 stdout
ADVERSARIAL_GAP_REVIEW=false  # true = 候选先经过 Research Risk Auditor gate
