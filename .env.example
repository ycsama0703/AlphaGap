# Copy to .env and fill in real values

# DeepSeek API（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_DEFAULT=deepseek-chat
DEEPSEEK_MODEL_REASONING=deepseek-reasoner

# Semantic Scholar（可选 API key 提速）
S2_API_KEY=

# Email — Resend
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=alphagap@yourdomain.com
EMAIL_TO=yuncong@lum.id

# Paths
ALPHAGAP_DB_PATH=db/alphagap.sqlite
ALPHAGAP_DATA_DIR=.

# Logging
LOG_LEVEL=INFO

# Behavior
DRY_RUN=false            # true = 不发邮件、不写 inbox，只 stdout
